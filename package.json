{
  "name": "devflow",
  "private": true,
  "description": "Real-time team Kanban board on Firebase. The site itself is plain files in public/ — these packages are only for local development and tests.",
  "type": "module",
  "scripts": {
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devflow \"node --test tests/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-devflow",
    "serve": "http-server public -p 5050 -c-1 -s",
    "deploy": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
