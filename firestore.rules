rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isApproved() {
      return isSignedIn() && exists(/databases/$(database)/documents/allowlist/$(myEmail()));
    }
    function myRole() {
      return get(/databases/$(database)/documents/allowlist/$(myEmail())).data.role;
    }
    function isAdmin() {
      return isApproved() && myRole() == 'admin';
    }
    function isAdminOrPM() {
      return isApproved() && (myRole() == 'admin' || myRole() == 'pm');
    }
    // Which fields an update touches.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Tickets: any approved user can read/create/update.
    match /tickets/{ticketId} {

      // Workflow rules for status moves:
      // - "In review" needs a reviewer on the ticket.
      // - "Done" can only be set by the ticket's reviewer, a PM, or an admin.
      function statusMoveAllowed() {
        let next = request.resource.data.get('status', '');
        return (next != 'in_review' || request.resource.data.get('reviewer', '') != '')
          && (next != 'done' || isAdminOrPM()
              || resource.data.get('reviewer', '').lower() == myEmail());
      }

      allow read: if isApproved();

      // New tickets start in Backlog, unarchived, created by the person
      // actually signed in.
      allow create: if isApproved()
        && request.resource.data.createdBy.lower() == myEmail()
        && request.resource.data.status == 'backlog'
        && request.resource.data.get('archived', false) == false;

      allow update: if isApproved()
        // id, number and creator details can never change after creation
        && !changedKeys().hasAny(['id', 'number', 'createdBy', 'createdAt'])
        // only admins/PMs can archive or restore, or touch an archived ticket
        && (!changedKeys().hasAny(['archived', 'archivedBy', 'archivedAt']) || isAdminOrPM())
        && (resource.data.get('archived', false) == false || isAdminOrPM())
        && (!changedKeys().hasAny(['status']) || statusMoveAllowed());

      // Tickets are archived, not deleted. Only an admin can permanently
      // delete one, and only after it has been archived.
      allow delete: if isAdmin() && resource.data.get('archived', false) == true;

      // Comments: any approved user can read and post (as themselves).
      // The author can edit the text of their own comment (unless it was
      // hidden). Admins/PMs can hide or unhide any comment. A comment can be
      // deleted by its author, or by an admin/PM.
      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved()
          && request.resource.data.author.lower() == myEmail()
          && request.resource.data.get('hidden', false) == false;
        allow update: if isApproved() && (
          (resource.data.author.lower() == myEmail()
            && resource.data.get('hidden', false) == false
            && changedKeys().hasOnly(['text', 'editedAt']))
          || (isAdminOrPM() && changedKeys().hasOnly(['hidden', 'hiddenBy', 'hiddenAt']))
        );
        allow delete: if isApproved() &&
          (resource.data.author.lower() == myEmail() || isAdminOrPM());
      }

      // Activity log: an append-only audit trail. Any approved user can
      // read and add entries (as themselves); nobody can edit or delete
      // one, by design.
      match /activity/{entryId} {
        allow read: if isApproved();
        allow create: if isApproved() && request.resource.data.actor.lower() == myEmail();
      }
    }

    // Ticket number counter, used so two people creating tickets at the
    // same moment never get the same TASK-### id. It only ever goes up.
    match /meta/counters {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.ticketNumber is int;
      allow update: if isApproved()
        && request.resource.data.ticketNumber is int
        && request.resource.data.ticketNumber > resource.data.ticketNumber;
    }

    // Board settings (Discord webhook URL, WIP limits, stale threshold).
    // Approved users can read them; only admins can change them. Keeping
    // the webhook here instead of in js/discord.js keeps it out of the
    // public site source.
    match /config/settings {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Allow list: a user can always read their own entry (so the app can
    // tell them "pending approval"). Any approved user can read the full
    // roster (needed for the assignee dropdown). Only admins can add
    // people, remove people, or change roles.
    match /allowlist/{email} {
      allow read: if isSignedIn() && myEmail() == email;
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Access requests: a signed-in user can create/read only their own
    // request (used to power "Request access" on the pending screen).
    // Admins can read and delete any request (delete = approve or deny,
    // both happen from the Team tab).
    match /accessRequests/{email} {
      allow create, read: if isSignedIn() && myEmail() == email;
      allow read, delete: if isAdmin();
    }

    // Profiles: any approved teammate can view anyone's profile (name,
    // username, bio, time zone, last active — used for avatars, the
    // assignee dropdown, and the Team/Profile views). You can only ever
    // write your own profile document.
    match /profiles/{email} {
      allow read: if isApproved();
      allow write: if isSignedIn() && myEmail() == email;
    }
  }
}
